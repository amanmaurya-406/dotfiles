// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",                    // 'auto' detects the best protocol for your terminal
        "width": 16,                       // Adjust width (in characters)
        "padding": {
            "top": 1,
            "right": 4,
            "left": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭────────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys} │",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys} │",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {#33}{icon} uptime  {#keys} │",
            "type": "uptime"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys} │",
            "type": "os"
        },
        {
            "key": "│ {#35}{icon} kernel  {#keys} │",
            "type": "kernel"
        },
        {
            "type": "command",
            "key": "│ {#36} packages {#keys}│",
            "text": "pacman -Q | wc -l"
        },
        {
            "key": "│ {#32}{icon} wm      {#keys} │",
            "type": "wm"
        },
        {
            "key": "│ {#33}{icon} term    {#keys} │",
            "type": "terminal"
        },
        {
            "key": "│ {#34}{icon} shell   {#keys} │",
            "type": "shell"
        },
        {
            "key": "│ {#35}{icon} cpu     {#keys} │",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#36}{icon} gpu     {#keys} │",
            "type": "gpu"
        },
        {
            "key": "│ {#32}{icon} disk    {#keys} │",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#33}{icon} memory  {#keys} │",
            "type": "memory"
        },
        {
            "key": "│ {#35}{icon} network {#keys} │",
            "type": "localip",
            "format": "{ipv4} ({ifname})"
        },
        {
            "type": "command",
            "key": "│ {#33}{icon} locale  {#keys} │",
            "text": "cut -d= -f2 /etc/locale.conf"
        },
        {
            "key": "├────────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#37} colors  {#keys} │",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰────────────╯",
            "type": "custom"
        }
    ]
}
