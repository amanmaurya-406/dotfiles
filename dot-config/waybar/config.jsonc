{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 2,
  "margin": "0 0 0 0",

  "modules-left": [
    "clock",
    "custom/swap",
  ],

  "modules-center": [
    "sway/workspaces",
  ],

  "modules-right": [
    "cpu",
    "network",
    "battery",
    "custom/power"
  ],

  // Load Modules 
  "include": ["~/.config/waybar/modules.json"],
}
